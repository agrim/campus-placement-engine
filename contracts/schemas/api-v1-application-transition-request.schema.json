{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpe:api:v1:application-transition-request",
  "title": "Campus Placement Engine API v1 application transition request",
  "type": "object",
  "additionalProperties": false,
  "required": ["transition_key", "target_status"],
  "properties": {
    "transition_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,79}$"
    },
    "target_status": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,79}$"
    },
    "note": {
      "type": "string",
      "maxLength": 1000,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    }
  }
}
