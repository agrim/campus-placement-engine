{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpe:api:v1:meta",
  "title": "Campus Placement Engine API v1 response metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id"],
  "properties": {
    "request_id": { "$ref": "#/$defs/request_id" }
  },
  "$defs": {
    "request_id": {
      "type": "string",
      "pattern": "^req_[a-f0-9]{32}$"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^inc_(?:[a-f0-9]{32}|unavailable)$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
