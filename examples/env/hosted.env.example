# Hosted Career Services Portal process environment example.
# Values are synthetic. Supply real secrets through a secret manager.

CPE_HOSTED_MODE=1
CPE_CONTROL_PLANE_DATABASE_URL=postgresql://control_user:replace-password@control-db.example/control_plane

# The control plane stores only the reference EXAMPLE_COLLEGE. The resolved URL
# is injected into the application process and never written to control tables.
CPE_TENANT_DATABASE_URL_EXAMPLE_COLLEGE=postgresql://tenant_user:replace-password@tenant-db.example/example_college

CPE_SESSION_DRIVER=database
CPE_SESSION_SECURE=force
CPE_TRUST_PROXY_HEADERS=1

CPE_LOG_PATH=/var/log/career-services/requests.jsonl
CPE_METRICS_TOKEN=replace-with-at-least-24-random-characters
CPE_HOSTED_BACKUP_DIR=/srv/encrypted-backups/career-services

# Optional institutional identity-proxy bridge.
CPE_SSO_ENABLED=1
CPE_SSO_PROVIDER_KEY=oidc_proxy
CPE_SSO_SHARED_SECRET=replace-with-at-least-32-random-characters

# Optional domain-event webhook for approved integrations.
CPE_DOMAIN_EVENT_WEBHOOK_URL=https://integration.example.edu/career-events
CPE_DOMAIN_EVENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
