# Campus Placement Engine local environment example.
# Copy values into your shell, hosting control panel, or process manager.
# Do not commit real .env files, credentials, gateway tokens, or phone routes.

# Optional database override. Default is data/app.sqlite.
CPE_DB_PATH=/absolute/path/to/campus-placement-engine/data/app.sqlite
# For PostgreSQL instead, omit CPE_DB_PATH and set a secret URL in the process:
# CPE_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/career_services?sslmode=disable
# Local loopback PostgreSQL without TLS additionally requires these explicit
# test-only settings. Production must use verify-full, sslrootcert, and a
# bounded connect_timeout as documented in docs/environment.md.
# CPE_POSTGRES_POOL_MODE=direct
# CPE_POSTGRES_ALLOW_INSECURE_LOOPBACK=1

# First-run CLI install. Prefer this environment variable over passing the
# admin password as a command argument.
CPE_ADMIN_PASSWORD=change-this-password
CPE_COLLEGE_NAME=Example College
CPE_ADMIN_NAME=Placement Admin
CPE_ADMIN_EMAIL=admin@example.edu
CPE_TIMEZONE=Asia/Kolkata
CPE_WORKFLOW=default

# Remote browser setup only: generate a fresh 32-byte base64url value and set
# CPE_SETUP_TOKEN in the host's secret manager. Never commit the value or put it
# in a URL. `php placement setup` prints its own 20-minute local code once to
# the trusted terminal; the reserved internal capability variables are not
# configuration. CPE_INTERNAL_SETUP_CAPABILITY, CPE_INTERNAL_SETUP_ADDRESS, and
# CPE_INTERNAL_SETUP_EXPIRES are reserved.

# Local development and smoke checks.
CPE_SERVE_ADDRESS=127.0.0.1:8000
CPE_SMOKE_BASE_URL=http://127.0.0.1:8000
CPE_SMOKE_EMAIL=admin@example.edu
CPE_SMOKE_PASSWORD=change-this-password
CPE_LOAD_BASE_URL=http://127.0.0.1:8000

# Session cookies. Use force behind a TLS-terminating proxy if PHP does not see
# HTTPS. Use never only for local HTTP testing.
CPE_SESSION_SECURE=auto
# CPE_TRUST_PROXY_HEADERS=1
# CPE_SESSION_DRIVER=database

# Optional local structured logs and operational probe token. Managed-hosting
# readiness and metrics require this token in the HTTP Authorization header.
# CPE_LOG_PATH=/absolute/private/path/cpe.jsonl
# CPE_METRICS_TOKEN=replace-with-at-least-24-random-characters

# Paste-based CSV import limits.
CPE_IMPORT_MAX_BYTES=5000000
CPE_IMPORT_MAX_ROWS=10000

# Optional external notification handoff. Keep tokens and live routes private.
# HTTPS and public-network destinations are required by default.
CPE_NOTIFICATION_WEBHOOK_URL=https://example.edu/placement-hook
CPE_NOTIFICATION_EMAIL_TO=placement-office@example.edu
CPE_NOTIFICATION_EMAIL_FROM=placements@example.edu
CPE_NOTIFICATION_SMS_GATEWAY_URL=https://sms.example.edu/send
CPE_NOTIFICATION_SMS_AUTHORIZATION=Bearer replace-with-provider-token
CPE_NOTIFICATION_SMS_TO=placement-test-route
CPE_NOTIFICATION_WHATSAPP_GATEWAY_URL=https://wa.example.edu/send
CPE_NOTIFICATION_WHATSAPP_AUTHORIZATION=Bearer replace-with-provider-token
CPE_NOTIFICATION_WHATSAPP_TO=placement-test-route

# Local outboxes for dry runs and integration handoff.
CPE_NOTIFICATION_FILE_OUTBOX_PATH=/tmp/cpe-notification-outbox.jsonl
CPE_NOTIFICATION_EMAIL_OUTBOX_PATH=/tmp/cpe-email-outbox.jsonl
CPE_NOTIFICATION_MESSAGE_OUTBOX_PATH=/tmp/cpe-message-outbox.jsonl

# Local-only HTTP testing. Leave private-network delivery disabled unless a
# reviewed internal gateway is an intentional process trust boundary.
# CPE_NOTIFICATION_ALLOW_HTTP=1
# CPE_OUTBOUND_ALLOW_PRIVATE_NETWORK=1

# Optional signed webhook integrations are created by an administrator in the
# Integrations page. Generate each real 32-byte key outside this repository and
# keep the keyring in the host secret manager.
# CPE_WEBHOOK_ENCRYPTION_KEYS=version-id=<canonical-unpadded-base64url-32-byte-key>
# CPE_WEBHOOK_ACTIVE_KEY_VERSION=version-id
# CPE_WEBHOOK_ALLOWED_PORTS=443
# CPE_WEBHOOK_ENDPOINT_CONCURRENCY=1
# CPE_WEBHOOK_INSTITUTION_CONCURRENCY=5

# Self-hosted private-network HTTP needs both the per-integration administrator
# choice, this process opt-in, and an explicitly approved port. Managed hosting
# remains public-egress HTTPS only.
# CPE_WEBHOOK_ALLOW_HTTP=1

# Optional public read API identity and cursor keyring. The API remains disabled
# in local institution settings until an administrator explicitly enables it.
# Generate each real 32-byte key outside this repository and keep it in a secret manager.
# Do not reuse webhook encryption keys.
# CPE_API_KEYRING=version-id=<canonical-unpadded-base64url-32-byte-key>
# CPE_API_ACTIVE_KEY_VERSION=version-id

# Optional diagnostics-only governed event copy; not production delivery.
# CPE_DOMAIN_EVENT_DIAGNOSTIC_OUTBOX_PATH=/absolute/private/path/cpe-domain-events.jsonl
