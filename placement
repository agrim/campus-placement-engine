function upgrade(array $args): void
{
    if (in_array('--help', $args, true) || in_array('-h', $args, true)) {
        upgrade_help();
        return;
    }
    if ($args !== []) {
        throw new UserVisibleException('CLI_UPGRADE_ARGUMENT_INVALID', 'Upgrade does not accept positional arguments.');
    }
    (new SystemRequirements())->assertReady();
    Database::adoptInstalledEngineOwnershipForUpgrade();
    if (!Database::hasInstalledMarkerStrict()) {
        throw new UserVisibleException('CLI_APP_NOT_INSTALLED', 'App is not installed.');
    }
    $backup = create_database_backup('upgrade');
    echo "Upgrade backup written. A recovery path is available only to the operator who configured backup storage.\n";
    Database::migrate();
    echo "Migrations applied.\n";

    $snapshot = (new ReadinessService())->snapshot();
    print_readiness_snapshot($snapshot);
    $failures = array_values(array_filter($snapshot['checks'], fn (array $check): bool => $check['status'] === 'fail'));
    if ($failures !== []) {
        throw new UserVisibleException(
            'CLI_UPGRADE_READINESS_FAILED',
            'Upgrade completed migrations, but readiness has failing checks.',
        );
    }
    echo "Upgrade complete.\n";
}

function serve(
    array $args,
    ?string $internalCapability = null,
    ?string $internalAddress = null,
    ?int $internalExpiresAt = null,
): void
{
    $internalSetup = $internalCapability !== null
        && $internalAddress !== null
        && $internalExpiresAt !== null;
    if (!$internalSetup) {
        SetupHttp::scrubInternalEnvironment();
    }
    if (in_array('--help', $args, true) || in_array('-h', $args, true)) {
        serve_help();
        return;
    }
    $address = (string) ($args[0] ?? getenv('CPE_SERVE_ADDRESS') ?: '127.0.0.1:8000');
    if (!preg_match('/^[A-Za-z0-9._-]+:[0-9]{2,5}$/', $address)) {
        serve_help();
        throw new UserVisibleException(
            'CLI_SERVE_ADDRESS_INVALID',
            'Serve address must look like 127.0.0.1:8000 or localhost:8000.',
        );
    }
    [, $port] = explode(':', $address, 2);
    $portNumber = (int) $port;
    if ($portNumber < 1 || $portNumber > 65535) {
        throw new UserVisibleException('CLI_SERVE_PORT_INVALID', 'Serve port must be between 1 and 65535.');
    }

    if ($internalSetup) {
        if (!hash_equals($address, $internalAddress)) {
            throw new RuntimeException('Internal setup authority does not match the server bind.');
        }
        SetupHttp::setInternalEnvironment($internalCapability, $internalAddress, $internalExpiresAt);
    }

    echo "Starting Campus Placement Engine at http://{$address}/\n";
    echo "Press Ctrl+C to stop.\n";
    try {
        passthru(
            escapeshellarg(PHP_BINARY)
                . ' -S ' . escapeshellarg($address)
                . ' -t ' . escapeshellarg(cpe_path('public'))
                . ' ' . escapeshellarg(cpe_path('public/router.php')),
            $exitCode,
        );
    } finally {
        SetupHttp::scrubInternalEnvironment();
    }
    exit((int) $exitCode);
}

function setup(array $args): void
{
    if (in_array('--help', $args, true) || in_array('-h', $args, true)) {
        setup_help();
        return;
    }

    $checkOnly = false;
    $serveArgs = [];
    foreach ($args as $arg) {
        if ($arg === '--check') {
            $checkOnly = true;
            continue;
        }
        $serveArgs[] = $arg;
    }
    if (count($serveArgs) > 1) {
        throw new UserVisibleException('CLI_SETUP_ARGUMENT_INVALID', 'Setup accepts one optional loopback address.');
    }
    $requestedAddress = (string) ($serveArgs[0] ?? getenv('CPE_SERVE_ADDRESS') ?: '127.0.0.1:8000');
    $setupAddress = SetupHttp::normalizeSetupAddress($requestedAddress);

    echo "Checking this computer before setup...\n";
    doctor();
    echo "\n";
    if (Database::isInstalled()) {
        echo "An installation already exists. The site will open at the address below.\n";
    } else {
        echo "Ready. Open the address below and follow the guided setup.\n";
        echo "You can try synthetic sample data or start with an empty installation.\n";
    }

    if ($checkOnly) {
        echo "Setup check complete. Run `php placement setup` to start the site.\n";
        return;
    }
    if (Database::isInstalled()) {
        serve([$setupAddress]);
    }

    $capability = SetupHttp::generateInternalCapability();
    $expiresAt = time() + SetupAuthorization::GRANT_TTL_SECONDS;
    echo "One-time setup code (valid for 20 minutes): {$capability}\n";
    echo "Enter this code in the browser setup page. It is trusted terminal output and is not placed in the URL.\n";
    serve([$setupAddress], $capability, $setupAddress, $expiresAt);
}

function install_app(array $args): void
{
    if (in_array('--help', $args, true) || in_array('-h', $args, true)) {
        install_help();
        return;
    }
    $installationState = Database::installationStateStrict();
    if ($installationState === InstallationState::INSTALLED) {
        throw new UserVisibleException(
            'CLI_APP_ALREADY_INSTALLED',
            'App is already installed. Use upgrade or configuration import for an existing installation.',
        );
    }

    $options = cli_options($args);
    $input = [
        'college_name' => (string) ($options['college'] ?? $options['college-name'] ?? getenv('CPE_COLLEGE_NAME') ?: ''),
        'site_name' => (string) ($options['site-name'] ?? getenv('CPE_SITE_NAME') ?: cpe_config('app.name')),
        'site_tagline' => (string) ($options['site-tagline'] ?? getenv('CPE_SITE_TAGLINE') ?: ''),
        'timezone' => (string) ($options['timezone'] ?? getenv('CPE_TIMEZONE') ?: 'Asia/Kolkata'),
        'cycle_name' => (string) ($options['cycle-name'] ?? getenv('CPE_CYCLE_NAME') ?: ''),
        'cycle_type' => (string) ($options['cycle-type'] ?? getenv('CPE_CYCLE_TYPE') ?: 'final'),
        'cycle_start_date' => (string) ($options['cycle-start-date'] ?? getenv('CPE_CYCLE_START_DATE') ?: ''),
        'cycle_end_date' => (string) ($options['cycle-end-date'] ?? getenv('CPE_CYCLE_END_DATE') ?: ''),
        'calendar_non_operating_weekdays' => (string) ($options['non-operating-weekdays'] ?? getenv('CPE_NON_OPERATING_WEEKDAYS') ?: ''),
        'calendar_non_operating_dates' => (string) ($options['non-operating-dates'] ?? getenv('CPE_NON_OPERATING_DATES') ?: ''),
        'audit_request_metadata' => (string) ($options['audit-request-metadata'] ?? getenv('CPE_AUDIT_REQUEST_METADATA') ?: 'none'),
        'workflow' => (string) ($options['workflow'] ?? getenv('CPE_WORKFLOW') ?: 'default'),
        'terminology_candidate_label' => (string) ($options['candidate-label'] ?? getenv('CPE_CANDIDATE_LABEL') ?: 'Candidate'),
        'terminology_candidates_label' => (string) ($options['candidates-label'] ?? getenv('CPE_CANDIDATES_LABEL') ?: 'Candidates'),
        'terminology_company_label' => (string) ($options['company-label'] ?? getenv('CPE_COMPANY_LABEL') ?: 'Company'),
        'terminology_companies_label' => (string) ($options['companies-label'] ?? getenv('CPE_COMPANIES_LABEL') ?: 'Companies'),
        'admin_name' => (string) ($options['admin-name'] ?? getenv('CPE_ADMIN_NAME') ?: ''),
        'admin_email' => (string) ($options['admin-email'] ?? getenv('CPE_ADMIN_EMAIL') ?: ''),
        'admin_password' => (string) ($options['admin-password'] ?? getenv('CPE_ADMIN_PASSWORD') ?: ''),
    ];
    $seedDemo = $options['seed-demo'] ?? getenv('CPE_SEED_DEMO') ?: '';
    if (cli_truthy($seedDemo)) {
        $input['seed_demo'] = '1';
    }

    if ($input['college_name'] === '' || $input['admin_name'] === '' || $input['admin_email'] === '' || strlen($input['admin_password']) < 8) {
        install_help();
        throw new UserVisibleException(
            'CLI_INSTALL_OPTIONS_REQUIRED',
            'Missing required install options: college, admin-name, admin-email, and an 8+ character admin password.',
        );
    }

    $adminId = (new Installer())->install($input);
    echo "Installed app.\n";
    echo "Admin user id: {$adminId}\n";
    echo "Login: {$input['admin_email']}\n";
}

