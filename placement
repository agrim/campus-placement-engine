function workflow_simulate(array $args): void
{
    require_installed_app();
    $options = cli_options($args);
    $repository = new WorkflowRepository(Database::connection());
    $versionId = (int) ($options['version'] ?? $repository->activeVersionId() ?? 0);
    $transitionKeys = array_values(array_filter(array_map('trim', explode(',', (string) ($options['transitions'] ?? '')))));
    if ($versionId <= 0 || $transitionKeys === []) {
        throw new UserVisibleException(
            'CLI_WORKFLOW_SIMULATION_ARGUMENTS_REQUIRED',
            'Use workflow-simulate --version=ID --transitions=key_one,key_two [--roles=role_one,role_two].',
        );
    }
    $roles = array_values(array_filter(array_map('trim', explode(',', (string) ($options['roles'] ?? 'admin')))));
    $steps = [];
    foreach ($transitionKeys as $index => $key) {
        $steps[] = [
            'transition_key' => $key,
            'actor_role' => $roles[$index] ?? end($roles) ?: 'admin',
            'reason' => (string) ($options['reason'] ?? ''),
        ];
    }
    $context = [
        'start_state' => (string) ($options['start'] ?? ''),
        'opted_out' => cli_truthy($options['opted-out'] ?? ''),
        'placement_frozen' => cli_truthy($options['placement-frozen'] ?? ''),
        'has_offer' => cli_truthy($options['has-offer'] ?? ''),
        'allow_offer_upgrade' => cli_truthy($options['allow-offer-upgrade'] ?? ''),
    ];
    if ($context['start_state'] === '') {
        unset($context['start_state']);
    }
    $result = (new WorkflowSimulationService(Database::connection()))->simulate($versionId, $steps, $context);
    echo "Workflow simulation: {$result['workflow_key']} version {$result['version_number']}\n";
    foreach ($result['trace'] as $step) {
        echo "{$step['step']}. {$step['from']} -> {$step['to']} via {$step['transition_key']} ({$step['actor_role']})\n";
    }
    echo "End state: {$result['end_state']}" . ($result['terminal'] ? ' (terminal)' : '') . "\n";
}

