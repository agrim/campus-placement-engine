function package_release(array $args): void
{
    if (!class_exists(PharData::class)) {
        throw new RuntimeException('PharData is required to build a release package.');
    }
    publication_check();
    $options = cli_options($args);
    $targetDir = (string) ($options['target'] ?? (__DIR__ . '/dist'));
    $force = cli_truthy($options['force'] ?? '');
    if (!is_dir($targetDir) && !mkdir($targetDir, 0775, true)) {
        throw new RuntimeException('Could not create package target directory: ' . $targetDir);
    }
    if (!is_writable($targetDir)) {
        throw new RuntimeException('Package target is not writable: ' . $targetDir);
    }
    putenv('TMPDIR=' . $targetDir);
    @ini_set('sys_temp_dir', $targetDir);

    $version = preg_replace('/[^A-Za-z0-9._-]/', '-', (string) cpe_config('app.version', '0.1.0')) ?: '0.1.0';
    $rootName = 'campus-placement-engine-' . $version;
    $tarPath = rtrim($targetDir, '/') . '/' . $rootName . '.tar';
    $gzPath = $tarPath . '.gz';
    $checksumPath = release_package_checksum_path($gzPath);
    foreach ([$tarPath, $gzPath, $checksumPath] as $path) {
        if (is_file($path)) {
            if (!$force) {
                throw new RuntimeException('Package already exists; rerun with --force: ' . $path);
            }
            if (!unlink($path)) {
                throw new RuntimeException('Could not replace existing package: ' . $path);
            }
        }
    }

    $archive = new PharData($tarPath);
    $count = 0;
    foreach (release_package_files() as $relative) {
        $archive->addFile(__DIR__ . '/' . $relative, $rootName . '/' . $relative);
        $count++;
    }
    $archive->compress(Phar::GZ);
    unset($archive);
    if (is_file($tarPath) && !unlink($tarPath)) {
        throw new RuntimeException('Could not remove intermediate package: ' . $tarPath);
    }
    write_release_package_checksum($gzPath);

    echo "Release package written: {$gzPath}\n";
    echo "Checksum written: {$checksumPath}\n";
    echo "Files included: {$count}\n";
}

function release_package_checksum_path(string $path): string
{
    return $path . '.sha256';
}

function write_release_package_checksum(string $path): void
{
    $hash = hash_file('sha256', $path);
    if ($hash === false) {
        throw new RuntimeException('Could not checksum release package: ' . $path);
    }
    $checksumPath = release_package_checksum_path($path);
    $line = $hash . '  ' . basename($path) . "\n";
    if (file_put_contents($checksumPath, $line) === false) {
        throw new RuntimeException('Could not write release package checksum: ' . $checksumPath);
    }
}

function verify_release_package(string $path): void
{
    if ($path === '' || !is_file($path)) {
        throw new RuntimeException('Provide a readable release package path.');
    }
    $checksumPath = release_package_checksum_path($path);
    if (!is_file($checksumPath)) {
        throw new RuntimeException('Release package checksum not found: ' . $checksumPath);
    }
    $contents = trim((string) file_get_contents($checksumPath));
    $expected = strtolower(strtok($contents, " \t"));
    if (!preg_match('/^[a-f0-9]{64}$/', $expected)) {
        throw new RuntimeException('Release package checksum file is invalid: ' . $checksumPath);
    }
    $actual = hash_file('sha256', $path);
    if ($actual === false || !hash_equals($expected, strtolower($actual))) {
        throw new RuntimeException('Release package checksum verification failed for: ' . $path);
    }
    if (!class_exists(PharData::class)) {
        throw new RuntimeException('PharData is required to inspect a release package.');
    }
    putenv('TMPDIR=' . dirname($path));
    @ini_set('sys_temp_dir', dirname($path));
    $archive = new PharData($path);
    $archivePrefix = 'phar://' . (realpath($path) ?: $path) . '/';
    $entries = [];
    $rootName = '';
    $uncompressedBytes = 0;
    foreach (new RecursiveIteratorIterator($archive) as $file) {
        if (!$file instanceof SplFileInfo || !$file->isFile()) {
            continue;
        }
        $pathname = $file->getPathname();
        if (!str_starts_with($pathname, $archivePrefix)) {
            throw new RuntimeException('Release package contains an unreadable archive entry.');
        }
        $entry = substr($pathname, strlen($archivePrefix));
        $segments = explode('/', $entry);
        $candidateRoot = (string) ($segments[0] ?? '');
        if ($entry === ''
            || str_contains($entry, "\0")
            || str_contains($entry, '\\')
            || in_array('', $segments, true)
            || in_array('.', $segments, true)
            || in_array('..', $segments, true)
            || preg_match('/^campus-placement-engine-[A-Za-z0-9._-]+$/', $candidateRoot) !== 1
            || $file->isLink()) {
            throw new RuntimeException('Release package contains an unsafe archive entry: ' . $entry);
        }
        if ($rootName === '') {
            $rootName = $candidateRoot;
        } elseif ($rootName !== $candidateRoot) {
            throw new RuntimeException('Release package must contain exactly one application root.');
        }
        $relative = implode('/', array_slice($segments, 1));
        if ($relative === '' || isset($entries[$relative])) {
            throw new RuntimeException('Release package contains an invalid or duplicate entry: ' . $entry);
        }
        $size = max(0, (int) $file->getSize());
        $uncompressedBytes += $size;
        if ($size > 20 * 1024 * 1024 || $uncompressedBytes > 100 * 1024 * 1024 || count($entries) >= 5000) {
            throw new RuntimeException('Release package exceeds safe inspection limits.');
        }
        $entries[$relative] = true;
    }
    foreach (['.htaccess', 'README.md', 'placement', 'public/.htaccess', 'public/index.php', 'database/.htaccess', 'database/migrations/001_initial.sql', 'database/migrations/pgsql/001_portal_baseline.sql', 'docs/environment.md', 'examples/env/local.env.example', 'examples/deployment/apache-vhost.conf', 'examples/deployment/nginx-server.conf', 'tests/.htaccess', 'data/.gitkeep', 'data/.htaccess'] as $required) {
        if (!isset($entries[$required])) {
            throw new RuntimeException('Release package is missing required file: ' . $required);
        }
    }
    foreach (['.legacy-private', 'data/app.sqlite', '.playwright-cli'] as $forbidden) {
        foreach (array_keys($entries) as $entry) {
            if ($entry === $forbidden || str_starts_with($entry, $forbidden . '/')) {
                throw new RuntimeException('Release package contains forbidden path: ' . $forbidden);
            }
        }
    }
    echo "Package checksum verified: {$path}\n";
    echo "Package archive inspected: " . count($entries) . " files.\n";
}

function release_package_files(): array
{
    $allowed = [
        '.github',
        '.htaccess',
        '.gitignore',
        'README.md',
        'LICENSE',
        'SECURITY.md',
        'CONTRIBUTING.md',
        'CODE_OF_CONDUCT.md',
        'placement',
        'app',
        'config',
        'database',
        'docs',
        'examples',
        'public',
        'tests',
        'data/.gitkeep',
        'data/.htaccess',
    ];
    $files = [];
    foreach ($allowed as $relative) {
        $path = __DIR__ . '/' . $relative;
        if (is_file($path)) {
            if (is_link($path)) {
                throw new RuntimeException('Release package refuses symbolic links: ' . $relative);
            }
            $files[] = $relative;
            continue;
        }
        if (!is_dir($path)) {
            continue;
        }
        $iterator = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS)
        );
        foreach ($iterator as $file) {
            if (!$file instanceof SplFileInfo || !$file->isFile()) {
                continue;
            }
            $relativePath = ltrim(str_replace(__DIR__, '', $file->getPathname()), '/');
            $realPath = $file->getRealPath();
            if ($file->isLink()
                || $realPath === false
                || !str_starts_with($realPath, rtrim((string) realpath(__DIR__), '/') . '/')) {
                throw new RuntimeException('Release package refuses symbolic links or out-of-tree files: ' . $relativePath);
            }
            if ($relativePath === 'config/local.php') {
                continue;
            }
            $files[] = $relativePath;
        }
    }
    sort($files);
    return $files;
}

