/**
 * @param array<string, string> $documents
 * @return list<string>
 */
function public_integration_artifact_failures(array $documents): array
{
    $decoded = [];
    $failures = [];
    foreach (public_integration_artifact_paths() as $path) {
        if (!array_key_exists($path, $documents)) {
            $failures[] = 'missing ' . $path;
            continue;
        }
        try {
            $value = json_decode($documents[$path], true, 64, JSON_THROW_ON_ERROR);
        } catch (JsonException) {
            $failures[] = 'malformed JSON in ' . $path;
            continue;
        }
        if (!is_array($value) || array_is_list($value)) {
            $failures[] = 'top-level JSON object required in ' . $path;
            continue;
        }
        $decoded[$path] = $value;
    }
    if ($failures !== []) {
        return $failures;
    }

    $contractPath = 'contracts/public-integration.v1.json';
    $expectedContract = [
        'schema' => 1,
        'event_schemas' => ['application.status_changed' => [1]],
        'api_scopes' => ['opportunities.read', 'applications.read', 'applications.transition'],
        'engine_api' => ['v1'],
    ];
    if ($decoded[$contractPath] !== $expectedContract) {
        $failures[] = 'public-integration.v1.json differs from the frozen event and governed API declaration';
    }

    $requiredEnvelope = [
        'event_id', 'event_type', 'schema_version', 'occurred_at',
        'instance_id', 'aggregate', 'data', 'trace',
    ];
    foreach ([
        'contracts/schemas/public-event-envelope.v1.schema.json',
        'contracts/schemas/application.status_changed.v1.schema.json',
    ] as $path) {
        $schema = $decoded[$path];
        $required = $schema['required'] ?? null;
        if (($schema['$schema'] ?? null) !== 'https://json-schema.org/draft/2020-12/schema'
            || ($schema['type'] ?? null) !== 'object'
            || ($schema['additionalProperties'] ?? null) !== false
            || !is_array($required)
            || array_values($required) !== $requiredEnvelope
            || (($schema['properties']['event_type']['const'] ?? null) !== 'application.status_changed')
            || (($schema['properties']['schema_version']['const'] ?? null) !== 1)
            || (($schema['properties']['aggregate']['additionalProperties'] ?? null) !== false)
            || (($schema['properties']['trace']['additionalProperties'] ?? null) !== false)) {
            $failures[] = 'strict producer envelope constraints differ in ' . $path;
        }
    }
    $eventSchema = $decoded['contracts/schemas/application.status_changed.v1.schema.json'];
    $envelopeSchema = $decoded['contracts/schemas/public-event-envelope.v1.schema.json'];
    if (!is_string($eventSchema['$id'] ?? null)
