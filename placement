function doctor(): void
{
    $requirements = new SystemRequirements();
    foreach ($requirements->checks() as $check) {
        echo ($check['ok'] ? 'OK' : 'ERROR') . " {$check['label']}: {$check['value']}\n";
    }
    echo "INFO database: " . Database::path() . "\n";
    echo "INFO installed: " . (Database::isInstalled() ? 'yes' : 'no') . "\n";
    $requirements->assertReady();
}

