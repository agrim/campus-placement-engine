    if (($openapi['x-cpe-contract-examples'] ?? null) !== $expectedExamples) {
        $failures[] = 'OpenAPI contract example declaration differs';
    }
    foreach ($expectedExamples as $relative) {
        if (!isset($decoded['contracts/' . $relative])) {
            $failures[] = 'OpenAPI contract example is unresolved: ' . $relative;
        }
    }

    foreach ([
        'contracts/examples/api-v1-opportunity-item.json',
        'contracts/fixtures/api-v1-opportunity.consumer.json',
