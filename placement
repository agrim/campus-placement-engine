function release_package_files(): array
{
    $allowed = [
        '.github',
        '.htaccess',
        '.gitignore',
        'README.md',
        'INSTALL.md',
        'LICENSE',
        'SECURITY.md',
        'CONTRIBUTING.md',
        'CODE_OF_CONDUCT.md',
        'placement',
        'app',
        'config',
        'contracts',
        'database',
        'docs',
        'examples',
        'public',
        'tests',
        'data/.gitkeep',
        'data/.htaccess',
    ];
    $files = [];
    foreach ($allowed as $relative) {
        $path = __DIR__ . '/' . $relative;
        if (is_file($path)) {
            if (is_link($path)) {
                throw new RuntimeException('Release package refuses symbolic links: ' . $relative);
            }
            $files[] = $relative;
            continue;
        }
        if (!is_dir($path)) {
            continue;
        }
        $iterator = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS)
        );
        foreach ($iterator as $file) {
            if (!$file instanceof SplFileInfo || !$file->isFile()) {
                continue;
            }
            $relativePath = ltrim(str_replace(__DIR__, '', $file->getPathname()), '/');
            $realPath = $file->getRealPath();
            if ($file->isLink()
                || $realPath === false
                || !str_starts_with($realPath, rtrim((string) realpath(__DIR__), '/') . '/')) {
                throw new RuntimeException('Release package refuses symbolic links or out-of-tree files: ' . $relativePath);
            }
            if ($relativePath === 'config/local.php') {
                continue;
            }
            $files[] = $relativePath;
        }
    }
    sort($files);
    return $files;
}

function deliver_notifications(array $args): void
{
    if (!Database::isInstalled()) {
        throw new UserVisibleException('CLI_APP_NOT_INSTALLED', 'App is not installed.');
    }
    Database::migrate();
    $options = cli_options($args);
    $channel = (string) ($options['channel'] ?? '');
    $limit = (int) ($options['limit'] ?? 100);
    $dryRun = cli_truthy($options['dry-run'] ?? '');
    $result = (new NotificationDeliveryService())->deliverPending($channel, $limit, $dryRun);
    echo "Notification deliveries checked: {$result['checked']}\n";
    echo "Claimed: {$result['claimed']}\n";
    echo "Delivered: {$result['delivered']}\n";
    echo "Failed: {$result['failed']}\n";
    echo "Retrying: {$result['retrying']}\n";
    echo "Dead-lettered: {$result['dead_lettered']}\n";
    echo "Outcome unknown: {$result['outcome_unknown']}\n";
    echo "Claim lost: {$result['claim_lost']}\n";
    if ($dryRun) {
        echo "Dry run: yes\n";
    }
    foreach ($result['rows'] as $row) {
        echo "{$row['id']},{$row['channel']},{$row['status']}";
        if ($row['error'] !== '') {
            echo ',' . $row['error'];
        }
        echo "\n";
    }
}

