function workflow_export(array $args): void
{
    require_installed_app();
    $options = cli_options($args);
    $repository = new WorkflowRepository(Database::connection());
    $versionId = (int) ($options['version'] ?? $repository->activeVersionId() ?? 0);
    if ($versionId <= 0) {
        throw new RuntimeException('Workflow export requires --version=ID or an active version.');
    }
    $workflow = $repository->workflowForVersion($versionId);
    if ($workflow === null) {
        throw new RuntimeException('Workflow version not found.');
    }
    $target = (string) ($options['target'] ?? cpe_data_path('config/workflow-' . $workflow['key'] . '-v' . $workflow['version_number'] . '.json'));
    $result = (new WorkflowDefinitionFileService(Database::connection()))->export($versionId, $target);
    echo "Workflow definition written: {$result['path']}\n";
    echo "Workflow: {$result['workflow_key']} version {$result['version']}\n";
}

