function export_snapshot_args(array $args): array
{
    $targetDir = null;
    $profile = 'full';
    for ($i = 0; $i < count($args); $i++) {
        $arg = (string) $args[$i];
        if ($arg === '--profile') {
            if (!isset($args[$i + 1])) {
                throw new RuntimeException('Missing value for --profile.');
            }
            $profile = (string) $args[++$i];
            continue;
