function cli_options(array $args): array
{
    $options = [];
    for ($i = 0; $i < count($args); $i++) {
        $arg = (string) $args[$i];
        if (!str_starts_with($arg, '--')) {
            throw new UserVisibleException(
                'CLI_ARGUMENT_INVALID',
                'Unexpected positional argument. Run the command with --help for accepted options.',
            );
        }
        $pair = substr($arg, 2);
        if ($pair === '') {
            throw new UserVisibleException('CLI_OPTION_INVALID', 'An empty option is not valid.');
        }
        if (str_contains($pair, '=')) {
            [$key, $value] = explode('=', $pair, 2);
            $options[$key] = $value;
            continue;
        }
        if (isset($args[$i + 1]) && !str_starts_with((string) $args[$i + 1], '--')) {
            $options[$pair] = (string) $args[++$i];
            continue;
        }
        $options[$pair] = '1';
    }
    return $options;
}

function cli_truthy(mixed $value): bool
{
    return in_array(strtolower((string) $value), ['1', 'true', 'yes', 'on'], true);
}
