    if (($decoded['contracts/schemas/api-v1-application.schema.json']['required'] ?? null) !== $applicationFields
        || array_keys($decoded['contracts/schemas/api-v1-application.schema.json']['properties'] ?? []) !== $applicationFields) {
        $failures[] = 'application API producer allowlist differs';
    }

    $openapi = $decoded['contracts/openapi.v1.json'];
    $expectedApiPaths = [
        '/api/v1',
        '/api/v1/opportunities',
        '/api/v1/opportunities/{public_id}',
        '/api/v1/applications',
        '/api/v1/applications/{public_id}',
        '/api/v1/applications/{public_id}/transitions',
    ];
    $actualApiPaths = is_array($openapi['paths'] ?? null) ? array_keys($openapi['paths']) : [];
    sort($expectedApiPaths);
    sort($actualApiPaths);
    if (($openapi['openapi'] ?? null) !== '3.1.0'
        || ($openapi['jsonSchemaDialect'] ?? null) !== 'https://json-schema.org/draft/2020-12/schema'
        || ($openapi['security'] ?? null) !== [['bearerAuth' => []]]
        || $actualApiPaths !== $expectedApiPaths
        || (($openapi['components']['securitySchemes']['bearerAuth'] ?? null) !== [
            'type' => 'http',
            'scheme' => 'bearer',
            'bearerFormat' => 'CPE API token',
        ])) {
        $failures[] = 'OpenAPI v1 root, path, or Bearer security contract differs';
    }
    $httpMethods = ['get', 'put', 'post', 'delete', 'options', 'head', 'patch', 'trace'];
    foreach (($openapi['paths'] ?? []) as $path => $pathItem) {
        if (!is_array($pathItem)) {
            $failures[] = 'OpenAPI path item is invalid: ' . $path;
            continue;
        }
        $methods = array_values(array_intersect(array_keys($pathItem), $httpMethods));
        sort($methods);
        $expectedMethods = $path === '/api/v1/applications/{public_id}/transitions'
            ? ['post']
            : ['get', 'head'];
        if ($methods !== $expectedMethods) {
            $failures[] = 'OpenAPI method map differs: ' . $path;
        }
        foreach ($methods as $method) {
            $operation = $pathItem[$method] ?? null;
            $command = $path === '/api/v1/applications/{public_id}/transitions';
            if (!is_array($operation)
                || array_key_exists('requestBody', $operation) !== $command
                || !is_string($operation['operationId'] ?? null)
                || !is_array($operation['responses'] ?? null)
                || !array_key_exists('200', $operation['responses'])) {
                $failures[] = 'OpenAPI operation is incomplete: ' . strtoupper($method) . ' ' . $path;
            }
        }
    }
    $expectedExamples = [
        'service' => 'examples/api-v1-service.json',
        'opportunity_item' => 'examples/api-v1-opportunity-item.json',
        'opportunity_collection' => 'examples/api-v1-opportunity-collection.json',
