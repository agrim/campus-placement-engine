function export_snapshot_args(array $args): array
{
    $targetDir = null;
    $profile = 'full';
    for ($i = 0; $i < count($args); $i++) {
        $arg = (string) $args[$i];
        if ($arg === '--profile') {
            if (!isset($args[$i + 1])) {
                throw new UserVisibleException('CLI_EXPORT_PROFILE_REQUIRED', 'Missing value for --profile.');
            }
            $profile = (string) $args[++$i];
            continue;
        }
        if (str_starts_with($arg, '--profile=')) {
            $profile = substr($arg, strlen('--profile='));
            continue;
        }
        if (str_starts_with($arg, '--')) {
            throw new UserVisibleException('CLI_EXPORT_OPTION_INVALID', 'Unknown export option. Run `php placement export --help`.');
        }
        if ($targetDir !== null) {
            throw new UserVisibleException('CLI_EXPORT_TARGET_INVALID', 'Only one export target directory can be supplied.');
        }
        $targetDir = $arg;
    }
    return [$targetDir, $profile];
}

