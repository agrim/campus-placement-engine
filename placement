}

function upgrade(array $args): void
{
    if (in_array('--help', $args, true) || in_array('-h', $args, true)) {
        upgrade_help();
        return;
    }
    if ($args !== []) {
        throw new RuntimeException('Unexpected upgrade argument: ' . implode(' ', $args));
    }
    if (!Database::isInstalled()) {
        throw new RuntimeException('App is not installed.');
    }

    (new SystemRequirements())->assertReady();
    $backup = create_database_backup('upgrade');
    echo "Upgrade backup written: {$backup}\n";
    Database::migrate();
    echo "Migrations applied.\n";

    $snapshot = (new ReadinessService())->snapshot();
    print_readiness_snapshot($snapshot);
    $failures = array_values(array_filter($snapshot['checks'], fn (array $check): bool => $check['status'] === 'fail'));
    if ($failures !== []) {
        throw new RuntimeException('Upgrade completed migrations, but readiness has failing checks.');
    }
    echo "Upgrade complete.\n";
}

function serve(array $args): void
{
    if (in_array('--help', $args, true) || in_array('-h', $args, true)) {
        serve_help();
        return;
    }
    $address = (string) ($args[0] ?? getenv('CPE_SERVE_ADDRESS') ?: '127.0.0.1:8000');
    if (!preg_match('/^[A-Za-z0-9._-]+:[0-9]{2,5}$/', $address)) {
        serve_help();
        throw new RuntimeException('Serve address must look like 127.0.0.1:8000 or localhost:8000.');
    }
    [, $port] = explode(':', $address, 2);
    $portNumber = (int) $port;
    if ($portNumber < 1 || $portNumber > 65535) {
        throw new RuntimeException('Serve port must be between 1 and 65535.');
    }

    echo "Starting Campus Placement Engine at http://{$address}/\n";
    echo "Press Ctrl+C to stop.\n";
    passthru(escapeshellarg(PHP_BINARY) . ' -S ' . escapeshellarg($address) . ' -t ' . escapeshellarg(cpe_path('public')), $exitCode);
    exit((int) $exitCode);
}

function install_app(array $args): void
{
