            echo ',' . $row['destination'];
        }
        if ($row['error'] !== '') {
            echo ',' . $row['error'];
        }
        echo "\n";
    }
    if ($result['failed'] > 0) {
        throw new RuntimeException('One or more domain events could not be delivered.');
    }
}

function certify_notifications(array $args): void
{
    if (in_array('--help', $args, true) || in_array('-h', $args, true)) {
        certify_notifications_help();
        return;
    }
    if (!Database::isInstalled()) {
        throw new RuntimeException('App is not installed.');
    }
    $options = cli_options($args);
    $channel = strtolower(trim((string) ($options['channel'] ?? '')));
    if ($channel === '') {
        throw new RuntimeException('Provide --channel=sms or --channel=whatsapp.');
    }
    $requireLiveGateway = cli_truthy($options['require-live'] ?? '');

    $report = (new NotificationDeliveryService())->certificationReport($channel, $requireLiveGateway);
    foreach ($report['checks'] as $check) {
        echo strtoupper((string) $check['status']) . ' ' . $check['key'] . ' - ' . $check['message'] . "\n";
    }
    if (!$report['ok']) {
        throw new RuntimeException(strtoupper($channel) . ' notification certification preflight failed.');
    }
    echo "Notification certification preflight passed for {$channel}.\n";
}

function smoke_http(array $args): void
{
    if (in_array('--help', $args, true) || in_array('-h', $args, true)) {
        smoke_http_help();
        return;
    }
    $options = cli_options($args);
    $baseUrl = rtrim((string) ($options['base-url'] ?? getenv('CPE_SMOKE_BASE_URL') ?: 'http://127.0.0.1:8000'), '/');
    if (!filter_var($baseUrl, FILTER_VALIDATE_URL) || !preg_match('/^https?:\/\//', $baseUrl)) {
        throw new RuntimeException('Provide a valid http(s) --base-url.');
    }
    $email = (string) ($options['email'] ?? getenv('CPE_SMOKE_EMAIL') ?: 'admin@example.test');
    $password = (string) ($options['password'] ?? getenv('CPE_SMOKE_PASSWORD') ?: getenv('CPE_ADMIN_PASSWORD') ?: 'password123');
    $restrictedEmail = trim((string) ($options['restricted-email'] ?? getenv('CPE_SMOKE_RESTRICTED_EMAIL') ?: ''));
    $restrictedPassword = (string) ($options['restricted-password'] ?? getenv('CPE_SMOKE_RESTRICTED_PASSWORD') ?: $password);
    $timeout = max(1, min(30, (int) ($options['timeout'] ?? 5)));
    if (!filter_var($email, FILTER_VALIDATE_EMAIL) || $password === '') {
        throw new RuntimeException('Provide a valid --email and non-empty --password.');
    }
    if ($restrictedEmail !== '' && (!filter_var($restrictedEmail, FILTER_VALIDATE_EMAIL) || $restrictedPassword === '')) {
        throw new RuntimeException('Provide a valid --restricted-email and non-empty --restricted-password.');
    }

    $cookies = [];
    $checks = 0;
    $loginPage = http_smoke_request('GET', $baseUrl . '/?r=login', [], $cookies, $timeout);
    http_smoke_assert($loginPage, 200, 'login page');
    http_smoke_assert_security_headers($loginPage, 'login page');
    $sessionCookie = http_smoke_cookie_header($loginPage['headers'], (string) cpe_config('security.session_name', 'cpe_session'));
    if ($sessionCookie === '' || stripos($sessionCookie, 'HttpOnly') === false || stripos($sessionCookie, 'SameSite=Lax') === false) {
        throw new RuntimeException('Login page did not set a hardened HttpOnly SameSite=Lax session cookie.');
    }
    $token = http_smoke_csrf_token($loginPage['body']);
    echo "OK login page\n";
    $checks++;

    $anonymousPublic = http_smoke_request('GET', $baseUrl . '/?r=public', [], $cookies, $timeout);
    http_smoke_assert($anonymousPublic, 200, 'anonymous public placements');
    if (str_contains($anonymousPublic['body'], 'C001') || str_contains($anonymousPublic['body'], 'Demo Candidate')) {
        throw new RuntimeException('Anonymous public placements exposed candidate identity data.');
    }
    echo "OK anonymous aggregate public placements\n";
    $checks++;

    $anonymousStudent = http_smoke_request('GET', $baseUrl . '/?r=student', [], $cookies, $timeout);
    if (!in_array($anonymousStudent['status'], [302, 303], true)
        || !str_contains(http_smoke_header($anonymousStudent['headers'], 'Location'), 'r=login')) {
        throw new RuntimeException('Anonymous candidate status lookup should redirect to sign-in.');
    }
    echo "OK anonymous candidate lookup block\n";
    $checks++;

    $login = http_smoke_request('POST', $baseUrl . '/?r=login', [
        '_token' => $token,
        'email' => $email,
        'password' => $password,
    ], $cookies, $timeout);
    if (!in_array($login['status'], [302, 303], true)) {
        throw new RuntimeException('Login POST did not redirect; received HTTP ' . $login['status'] . '.');
    }
    $loginLocation = http_smoke_header($login['headers'], 'Location');
    if ($loginLocation !== '' && str_contains($loginLocation, 'r=login')) {
        throw new RuntimeException('Login POST redirected back to sign-in; check --email and --password.');
    }
    echo "OK login post\n";
    $checks++;

    $pages = [
        'board' => '/?r=board',
        'records' => '/?r=records',
        'reports' => '/?r=reports',
        'import' => '/?r=import',
        'notifications' => '/?r=notifications',
        'admin' => '/?r=admin',
        'system' => '/?r=system',
        'public' => '/?r=public',
        'student' => '/?r=student',
    ];
    foreach ($pages as $label => $path) {
        $response = http_smoke_request('GET', $baseUrl . $path, [], $cookies, $timeout);
        http_smoke_assert($response, 200, $label);
        if (str_contains($response['body'], '<h1>Sign in</h1>')) {
            throw new RuntimeException("HTTP smoke reached sign-in page while checking {$label}; login likely failed.");
        }
        if ($label === 'board') {
            $hasMovementForm = str_contains($response['body'], '?r=move') || str_contains($response['body'], '?r=return-to-idle');
            if ($hasMovementForm && !str_contains($response['body'], 'name="idempotency_key"')) {
                throw new RuntimeException('Board forms are missing idempotency keys.');
            }
            if (str_contains($response['body'], 'Board refreshes every') && !str_contains($response['body'], 'http-equiv="refresh"')) {
                throw new RuntimeException('Board reports automatic refresh but the refresh meta tag is missing.');
            }
            if (str_contains($response['body'], 'Board auto-refresh is off') && str_contains($response['body'], 'http-equiv="refresh"')) {
                throw new RuntimeException('Board reports refresh disabled but a refresh meta tag is present.');
            }
        } elseif (str_contains($response['body'], 'http-equiv="refresh"')) {
            throw new RuntimeException("HTTP smoke found unexpected refresh meta tag on {$label} page.");
        }
        echo "OK {$label}\n";
        $checks++;
    }

    $css = http_smoke_request('GET', $baseUrl . '/assets/app.css', [], $cookies, $timeout);
    http_smoke_assert($css, 200, 'css asset');
    if (!str_contains($css['body'], 'body')) {
        throw new RuntimeException('CSS asset response did not look like the app stylesheet.');
    }
    echo "OK css asset\n";
    $checks++;

    if ($restrictedEmail !== '') {
        $restrictedCookies = [];
        $restrictedLoginPage = http_smoke_request('GET', $baseUrl . '/?r=login', [], $restrictedCookies, $timeout);
        http_smoke_assert($restrictedLoginPage, 200, 'restricted login page');
        http_smoke_assert_security_headers($restrictedLoginPage, 'restricted login page');
        $restrictedToken = http_smoke_csrf_token($restrictedLoginPage['body']);
        echo "OK restricted login page\n";
        $checks++;

        $restrictedLogin = http_smoke_request('POST', $baseUrl . '/?r=login', [
            '_token' => $restrictedToken,
            'email' => $restrictedEmail,
            'password' => $restrictedPassword,
        ], $restrictedCookies, $timeout);
        if (!in_array($restrictedLogin['status'], [302, 303], true)) {
            throw new RuntimeException('Restricted login POST did not redirect; received HTTP ' . $restrictedLogin['status'] . '.');
        }
        $restrictedLocation = http_smoke_header($restrictedLogin['headers'], 'Location');
        if ($restrictedLocation !== '' && str_contains($restrictedLocation, 'r=login')) {
            throw new RuntimeException('Restricted login POST redirected back to sign-in; check --restricted-email and --restricted-password.');
        }
        echo "OK restricted login post\n";
        $checks++;

        $restrictedAllowed = [
            'restricted board' => '/?r=board',
            'restricted notifications' => '/?r=notifications',
            'restricted public' => '/?r=public',
            'restricted student' => '/?r=student',
        ];
        foreach ($restrictedAllowed as $label => $path) {
            $response = http_smoke_request('GET', $baseUrl . $path, [], $restrictedCookies, $timeout);
            http_smoke_assert($response, 200, $label);
            if (str_contains($response['body'], '<h1>Sign in</h1>')) {
                throw new RuntimeException("HTTP smoke reached sign-in page while checking {$label}; restricted login likely failed.");
            }
            echo "OK {$label}\n";
            $checks++;
        }

        $restrictedForbidden = [
            'restricted records block' => '/?r=records',
            'restricted reports block' => '/?r=reports',
            'restricted import block' => '/?r=import',
            'restricted preferences block' => '/?r=preferences',
            'restricted wanted block' => '/?r=wanted',
            'restricted admin block' => '/?r=admin',
            'restricted system block' => '/?r=system',
        ];
        foreach ($restrictedForbidden as $label => $path) {
            $response = http_smoke_request('GET', $baseUrl . $path, [], $restrictedCookies, $timeout);
            if (!in_array($response['status'], [302, 303], true)) {
                throw new RuntimeException("HTTP smoke failed for {$label}: expected a redirect, received HTTP " . (int) $response['status'] . '.');
            }
            $location = http_smoke_header($response['headers'], 'Location');
            if ($location !== '/') {
                throw new RuntimeException("HTTP smoke failed for {$label}: expected redirect to /, received " . ($location === '' ? 'no Location header' : $location) . '.');
            }
            echo "OK {$label}\n";
            $checks++;
        }
    }

    echo "HTTP smoke passed: {$checks} checks.\n";
}

function load_smoke(array $args): void
{
    if (in_array('--help', $args, true) || in_array('-h', $args, true)) {
        load_smoke_help();
        return;
    }
    $options = cli_options($args);
    $baseUrl = (string) ($options['base-url'] ?? getenv('CPE_LOAD_BASE_URL') ?: 'http://127.0.0.1:8000');
    $path = (string) ($options['path'] ?? '/?r=public');
    $requests = (int) ($options['requests'] ?? 50);
    $concurrency = (int) ($options['concurrency'] ?? 5);
    $timeout = (int) ($options['timeout'] ?? 10);
    $minimumSuccessRate = (float) ($options['min-success-rate'] ?? 1.0);
    $maximumP95 = (float) ($options['max-p95-ms'] ?? 2000);
    if ($minimumSuccessRate < 0 || $minimumSuccessRate > 1 || $maximumP95 <= 0) {
        throw new RuntimeException('Load thresholds require --min-success-rate between 0 and 1 and positive --max-p95-ms.');
    }
    $report = (new HttpLoadProbe())->run($baseUrl, $path, $requests, $concurrency, $timeout);
    echo "URL: {$report['url']}\n";
    echo "Transport: {$report['transport']}\n";
    echo "Requests: {$report['requests']} ({$report['successful']} successful, {$report['failed']} failed)\n";
    echo 'Success rate: ' . number_format($report['success_rate'] * 100, 2) . "%\n";
    echo "Throughput: {$report['requests_per_second']} requests/s\n";
    echo "Latency: p50 {$report['p50_ms']} ms, p95 {$report['p95_ms']} ms, max {$report['max_ms']} ms\n";
    echo 'Statuses: ' . json_encode($report['status_counts'], JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n";
    if ($report['errors'] !== []) {
        echo 'Errors: ' . json_encode($report['errors'], JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n";
    }
    if ($report['success_rate'] < $minimumSuccessRate || $report['p95_ms'] > $maximumP95) {
        throw new RuntimeException('Load smoke thresholds were not met.');
    }
    echo "Load smoke passed.\n";
}

function browser_qa_plan(array $args): void
{
    if (in_array('--help', $args, true) || in_array('-h', $args, true)) {
        browser_qa_plan_help();
        return;
    }
    $options = cli_options($args);
    $format = strtolower(trim((string) ($options['format'] ?? 'text')));
    if (!in_array($format, ['text', 'markdown'], true)) {
        throw new RuntimeException('Browser QA plan format must be text or markdown.');
    }
    $baseUrl = rtrim((string) ($options['base-url'] ?? getenv('CPE_QA_BASE_URL') ?: 'http://127.0.0.1:8000'), '/');
    if (!filter_var($baseUrl, FILTER_VALIDATE_URL) || !preg_match('/^https?:\/\//', $baseUrl)) {
        throw new RuntimeException('Provide a valid http(s) --base-url.');
    }
    $candidateTarget = max(1, min(5000, (int) ($options['candidate-target'] ?? 80)));
    $companyTarget = max(1, min(500, (int) ($options['company-target'] ?? 10)));

    $plan = browser_qa_plan_snapshot($baseUrl, $candidateTarget, $companyTarget);
    if ($format === 'markdown') {
        print_browser_qa_plan_markdown($plan);
        return;
    }
    print_browser_qa_plan_text($plan);
}

function browser_qa_plan_snapshot(string $baseUrl, int $candidateTarget, int $companyTarget): array
{
    $installed = Database::isInstalled();
    $counts = [
        'candidates' => 0,
        'companies' => 0,
        'applications' => 0,
        'active_applications' => 0,
    ];
    $readiness = [];
    if ($installed) {
        $pdo = Database::connection();
        $counts = [
            'candidates' => (int) $pdo->query('SELECT COUNT(*) FROM candidates')->fetchColumn(),
            'companies' => (int) $pdo->query('SELECT COUNT(*) FROM companies')->fetchColumn(),
            'applications' => (int) $pdo->query('SELECT COUNT(*) FROM applications')->fetchColumn(),
            'active_applications' => (int) $pdo->query("SELECT COUNT(*) FROM applications WHERE current_status NOT IN ('idle', 'placed')")->fetchColumn(),
        ];
        $readiness = (new ReadinessService($pdo))->snapshot()['checks'];
    }

    return [
        'base_url' => $baseUrl,
        'installed' => $installed,
        'candidate_target' => $candidateTarget,
        'company_target' => $companyTarget,
        'counts' => $counts,
        'routes' => browser_qa_routes($baseUrl),
        'matrix' => browser_qa_matrix(),
        'visual_checks' => browser_qa_visual_checks(),
        'readiness' => $readiness,
    ];
}

