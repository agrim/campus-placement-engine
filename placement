function http_smoke_request(string $method, string $url, array $form, array &$cookies, int $timeout): array
{
    $headers = [
        "User-Agent: CampusPlacementEngineSmoke/1.0\r\n",
        "Accept: text/html,application/xhtml+xml,text/css,*/*\r\n",
    ];
    if ($cookies !== []) {
        $pairs = [];
        foreach ($cookies as $name => $value) {
            $pairs[] = rawurlencode((string) $name) . '=' . rawurlencode((string) $value);
        }
        $headers[] = 'Cookie: ' . implode('; ', $pairs) . "\r\n";
    }
    $content = '';
    if ($method === 'POST') {
        $content = http_build_query($form);
        $headers[] = "Content-Type: application/x-www-form-urlencoded\r\n";
        $headers[] = 'Content-Length: ' . strlen($content) . "\r\n";
    }
    $context = stream_context_create([
        'http' => [
            'method' => $method,
            'header' => implode('', $headers),
            'content' => $content,
            'timeout' => $timeout,
            'ignore_errors' => true,
            'follow_location' => 0,
        ],
    ]);
    $body = @file_get_contents($url, false, $context);
    if ($body === false) {
        $error = error_get_last();
        throw new RuntimeException('HTTP request failed for ' . $url . ': ' . (string) ($error['message'] ?? 'unknown error'));
    }
    $responseHeaders = $http_response_header ?? [];
    $status = 0;
    if (isset($responseHeaders[0]) && preg_match('/\s(\d{3})\s/', $responseHeaders[0], $matches)) {
        $status = (int) $matches[1];
    }
    foreach ($responseHeaders as $header) {
        if (stripos($header, 'Set-Cookie:') !== 0) {
            continue;
        }
        $cookie = trim(substr($header, strlen('Set-Cookie:')));
        $pair = explode(';', $cookie, 2)[0] ?? '';
        if (!str_contains($pair, '=')) {
            continue;
        }
        [$name, $value] = explode('=', $pair, 2);
        $cookies[$name] = $value;
    }
    return ['status' => $status, 'headers' => $responseHeaders, 'body' => $body];
}

function http_smoke_assert(array $response, int $expectedStatus, string $label): void
{
    if ((int) $response['status'] !== $expectedStatus) {
        throw new RuntimeException("HTTP smoke failed for {$label}: expected {$expectedStatus}, received " . (int) $response['status'] . '.');
    }
    if (trim((string) $response['body']) === '') {
        throw new RuntimeException("HTTP smoke failed for {$label}: empty response body.");
    }
}

function http_smoke_assert_security_headers(array $response, string $label): void
{
    $expected = cpe_security_headers();
    foreach (['Content-Security-Policy', 'X-Frame-Options', 'X-Content-Type-Options', 'Referrer-Policy', 'Permissions-Policy', 'Cache-Control', 'Pragma'] as $name) {
        $actual = http_smoke_header($response['headers'], $name);
        if ($actual !== ($expected[$name] ?? '')) {
            throw new RuntimeException("HTTP smoke failed for {$label}: missing or unexpected {$name} header.");
        }
    }
}

function http_smoke_header(array $headers, string $name): string
{
    $prefix = strtolower($name) . ':';
    foreach ($headers as $header) {
        if (str_starts_with(strtolower((string) $header), $prefix)) {
            return trim(substr((string) $header, strlen($prefix)));
        }
    }
    return '';
}

function http_smoke_cookie_header(array $headers, string $cookieName): string
{
    foreach ($headers as $header) {
        if (stripos((string) $header, 'Set-Cookie:') !== 0) {
            continue;
        }
        $cookie = trim(substr((string) $header, strlen('Set-Cookie:')));
        if (str_starts_with($cookie, $cookieName . '=')) {
            return $cookie;
        }
    }
    return '';
}

function http_smoke_csrf_token(string $body): string
{
    if (preg_match('/name="_token"\s+value="([^"]+)"/', $body, $matches)) {
        return html_entity_decode($matches[1], ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
    }
    throw new RuntimeException('Could not find CSRF token on login page.');
}

