        }
    }
    foreach ([
        'contracts/examples/api-v1-application-item.json',
        'contracts/examples/api-v1-application-transition-response.json',
        'contracts/fixtures/api-v1-application.consumer.json',
        'contracts/fixtures/api-v1-application-transition.consumer.json',
    ] as $path) {
        if (array_keys($decoded[$path]) !== ['data', 'meta']
            || array_keys($decoded[$path]['data'] ?? []) !== $applicationFields
            || array_keys($decoded[$path]['meta'] ?? []) !== ['request_id']) {
            $failures[] = 'application API item shape differs in ' . $path;
        }
    }
    $futureApi = $decoded['contracts/fixtures/api-v1-opportunity.future-field.consumer.json'];
    $futureData = is_array($futureApi['data'] ?? null) ? $futureApi['data'] : [];
    if (($futureData['future_optional'] ?? null) === null) {
