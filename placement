function api_service_account_list(array $args): void
{
    require_installed_app();
    Database::migrate();
    $options = cli_options($args);
    $accounts = (new ApiServiceAccountService())->listForActor(api_actor_user_id($options));
    echo "service_account_id,name,status,scopes,tokens,current_or_grace_tokens\n";
    $handle = fopen('php://output', 'w');
    $now = cpe_now();
    foreach ($accounts as $account) {
        $usableMetadata = array_filter(
            $account['tokens'],
            static fn (array $token): bool => $token['revoked_at'] === null
                && (string) $token['expires_at'] > $now
                && ($token['rotation_grace_expires_at'] === null || (string) $token['rotation_grace_expires_at'] > $now),
        );
        Csv::writeRow($handle, [
            $account['public_id'],
            $account['name'],
            $account['status'],
            implode(',', $account['scopes']),
            count($account['tokens']),
            count($usableMetadata),
        ]);
    }
    fclose($handle);
}

function api_service_account_state(array $args, string $action): void
{
    require_installed_app();
    Database::migrate();
    $options = cli_options($args);
    $publicId = (string) ($options['service-account'] ?? '');
    $actor = api_actor_user_id($options);
    $service = new ApiServiceAccountService();
    match ($action) {
        'enable' => $service->setAccountEnabled($publicId, true, $actor),
        'disable' => $service->setAccountEnabled($publicId, false, $actor),
        'revoke' => $service->revokeAccount($publicId, $actor),
        default => throw new RuntimeException('Unknown API service-account lifecycle action.'),
    };
    echo 'API service account ' . $action . "d.\n";
}

