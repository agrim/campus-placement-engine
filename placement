function workflow_migrate(array $args): void
{
    require_installed_app();
    $options = cli_options($args);
    $versionId = (int) ($options['to-version'] ?? 0);
    $reason = trim((string) ($options['reason'] ?? ''));
    if ($versionId <= 0 || $reason === '' || (string) ($options['confirm'] ?? '') !== (string) $versionId) {
        throw new RuntimeException('Use workflow-migrate --to-version=ID --reason="..." --confirm=ID [--map=old:new,...].');
    }
    $service = new WorkflowMigrationService(Database::connection());
    $map = workflow_state_map((string) ($options['map'] ?? ''));
    $preview = $service->preview($versionId, $map);
    if ($preview['unmapped_states'] !== []) {
        print_workflow_migration_preview($preview);
        throw new RuntimeException('Supply mappings for every unmapped state before migration.');
    }
    $backup = create_database_backup('workflow-migration');
    echo "Workflow migration backup written: {$backup}\n";
    $result = $service->migrate($versionId, $map, null, 'admin', $reason);
    echo "Applications migrated: {$result['migrated']}\n";
}

function workflow_state_map(string $value): array
{
    $map = [];
    foreach (array_filter(array_map('trim', explode(',', $value))) as $pair) {
        if (!str_contains($pair, ':')) {
            throw new RuntimeException('Workflow state mappings use old:new pairs.');
        }
        [$from, $to] = array_map('trim', explode(':', $pair, 2));
        if ($from === '' || $to === '') {
            throw new RuntimeException('Workflow state mappings cannot be empty.');
        }
        $map[$from] = $to;
    }
    return $map;
}

