/** @param array<string, string|bool> $options */
function api_actor_user_id(array $options): int
{
    $actorUserId = filter_var(
        $options['actor-user-id'] ?? null,
        FILTER_VALIDATE_INT,
        ['options' => ['min_range' => 1]],
    );
    if ($actorUserId === false) {
        throw new UserVisibleException(
            'API_MANAGEMENT_ACTOR_INVALID',
            'Provide --actor-user-id for an active user with integration-management capability.',
        );
    }
    return (int) $actorUserId;
}

