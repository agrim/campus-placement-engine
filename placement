function print_browser_qa_readiness_status(array $plan, string $prefix): void
{
    if (!$plan['installed']) {
        echo "{$prefix}WARN readiness: app is not installed, so readiness checks are unavailable.\n";
        return;
    }
    $failures = array_values(array_filter($plan['readiness'], fn (array $check): bool => $check['status'] === 'fail'));
