function rollback_import(array $args): void
{
    if (!Database::isInstalled()) {
        throw new UserVisibleException('CLI_APP_NOT_INSTALLED', 'App is not installed.');
    }
    if ($args === [] || in_array((string) ($args[0] ?? ''), ['--list', 'list'], true)) {
        $rows = (new ImportRollbackService())->recent(20);
        if ($rows === []) {
            echo "No import rollback snapshots found.\n";
            return;
        }
        echo "id,type,rows,created_at,status\n";
        $handle = fopen('php://output', 'w');
        foreach ($rows as $row) {
            $status = !empty($row['restored_at'])
                ? 'restored'
                : (!empty($row['backup_exists'])
                    ? 'ready'
                    : (!empty($row['legacy_conversion_required'])
                        ? 'legacy_conversion_required'
                        : (!empty($row['legacy_recovery_required'])
                            ? 'legacy_postgres_isolated_validation_required'
                            : 'missing')));
            Csv::writeRow($handle, [$row['id'], $row['type'], (int) $row['rows'], $row['created_at'], $status]);
        }
        fclose($handle);
        return;
    }
    $id = (string) array_shift($args);
    $options = cli_options($args);
    foreach (array_keys($options) as $option) {
        if (!in_array($option, ['convert-legacy', 'confirm'], true)) {
            throw new UserVisibleException(
                'CLI_IMPORT_ROLLBACK_OPTION_INVALID',
                'Import rollback accepts only --convert-legacy and --confirm for legacy conversion.',
            );
        }
    }
    if (cli_truthy($options['convert-legacy'] ?? '')) {
        if ((string) ($options['confirm'] ?? '') !== 'CONVERT') {
            throw new UserVisibleException(
                'CLI_IMPORT_ROLLBACK_CONVERSION_CONFIRMATION_REQUIRED',
                'Legacy import rollback conversion requires --convert-legacy --confirm=CONVERT.',
            );
        }
        $manifest = (new ImportRollbackService())->convertLegacy($id);
        echo "Converted legacy import rollback snapshot: {$manifest['id']}\n";
        echo "Converted backup: {$manifest['backup_file']}\n";
        echo "The original legacy backup and checksum were preserved.\n";
        return;
    }
    if ($options !== []) {
        throw new UserVisibleException(
            'CLI_IMPORT_ROLLBACK_OPTION_INVALID',
            'Use --convert-legacy --confirm=CONVERT together for legacy conversion.',
        );
    }
    $manifest = (new ImportRollbackService())->restore($id);
    echo "Restored import rollback snapshot: {$manifest['id']}\n";
    echo "Safety backup created.\n";
}

