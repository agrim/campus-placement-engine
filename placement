    foreach ($apiSchemaPaths as $path => $schemaId) {
        $schema = $decoded[$path];
        if (($schema['$schema'] ?? null) !== 'https://json-schema.org/draft/2020-12/schema'
            || ($schema['$id'] ?? null) !== $schemaId
            || ($schema['type'] ?? null) !== 'object'
            || ($schema['additionalProperties'] ?? null) !== false) {
