function doctor(): void
{
    $requirements = new SystemRequirements();
    foreach ($requirements->checks() as $check) {
        echo ($check['ok'] ? 'OK' : 'ERROR') . " {$check['label']}: {$check['value']}\n";
    }
    $installed = Database::isInstalled();
    echo "INFO installed: " . ($installed ? 'yes' : 'no') . "\n";
    if ($installed) {
        if (Database::pendingMigrations() !== []) {
            throw new UserVisibleException(
                'CLI_DATABASE_UPGRADE_REQUIRED',
                'Database migrations are pending. Run `php placement upgrade`.',
            );
        }
        $api = (new ApiHealthService())->snapshot();
        echo strtoupper($api['status'] === 'fail' ? 'ERROR' : $api['status'])
            . ' API identity: ' . $api['message'] . "\n";
        echo 'INFO API service accounts: ' . (int) $api['service_accounts']
            . '; usable tokens: ' . (int) $api['usable_tokens']
            . '; missing key versions: ' . (int) $api['missing_key_versions'] . "\n";
        $webhooks = (new WebhookHealthService())->snapshot();
        echo strtoupper($webhooks['status'] === 'fail' ? 'ERROR' : $webhooks['status'])
            . ' signed webhooks: ' . $webhooks['message'] . "\n";
        echo 'INFO webhook network policy: ' . $webhooks['network_policy'] . "\n";
        echo 'INFO webhook encryption key version: '
            . ($webhooks['encryption_key_active_version'] !== '' ? $webhooks['encryption_key_active_version'] : 'not configured')
            . "\n";
    }
    $requirements->assertReady();
}

