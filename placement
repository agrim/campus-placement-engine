function convert_legacy_backup(array $args): void
{
    if ($args === [] || in_array('--help', $args, true) || in_array('-h', $args, true)) {
        echo "Convert a public alpha.1 SQLite backup without modifying the original:\n";
        echo "  php placement convert-legacy-backup /path/to/legacy.sqlite --confirm=CONVERT [--target-dir=/new/directory]\n";
        echo "PostgreSQL legacy archives require an isolated restore validation instead.\n";
        return;
    }
    $path = (string) array_shift($args);
    if ($path === '' || str_starts_with($path, '--')) {
        throw new UserVisibleException(
            'CLI_LEGACY_BACKUP_PATH_REQUIRED',
            'Provide the legacy SQLite backup path before conversion options.',
        );
    }
    $options = cli_options($args);
    foreach (array_keys($options) as $option) {
        if (!in_array($option, ['confirm', 'target-dir'], true)) {
            throw new UserVisibleException(
                'CLI_LEGACY_BACKUP_OPTION_INVALID',
                'Legacy backup conversion accepts only --confirm and --target-dir.',
            );
        }
    }
    if ((string) ($options['confirm'] ?? '') !== 'CONVERT') {
        throw new UserVisibleException(
            'CLI_LEGACY_BACKUP_CONFIRMATION_REQUIRED',
            'Legacy backup conversion requires --confirm=CONVERT and always writes a new archive.',
        );
    }
    $artifact = (new LegacySqliteBackupConverter())->convert(
        $path,
        isset($options['target-dir']) ? (string) $options['target-dir'] : null,
    );
    echo "Converted legacy SQLite backup: {$artifact->fileName()}\n";
    echo "Backup reference: {$artifact->reference()}\n";
    echo "The original archive and checksum were preserved. Keep the converted archive with both new sidecars.\n";
}

