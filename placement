function publication_check(): void
{
    $required = [
        'README.md',
        'LICENSE',
        'SECURITY.md',
        'CONTRIBUTING.md',
        'CODE_OF_CONDUCT.md',
        '.htaccess',
        'public/.htaccess',
        'data/.htaccess',
        'database/.htaccess',
        'database/migrations/pgsql/001_portal_baseline.sql',
        'tests/.htaccess',
        'docs/environment.md',
        'docs/release-checklist.md',
        'docs/migration-from-legacy.md',
        'examples/env/local.env.example',
        'examples/deployment/apache-vhost.conf',
        'examples/deployment/nginx-server.conf',
        '.gitignore',
    ];
    $failures = [];
    foreach ($required as $path) {
        if (!is_file(__DIR__ . '/' . $path)) {
            $failures[] = "Missing required release file: {$path}";
        }
    }

    $gitignore = is_file(__DIR__ . '/.gitignore') ? (string) file_get_contents(__DIR__ . '/.gitignore') : '';
    foreach (['/.legacy-private/', '/http/', '/dist/', '/.env', '/.env.*', '/config/local.php', '/data/*.sqlite', '/data/backups/', '/data/config/', '/data/imports/', '*.zip', '*.7z', '*.rar', '*.xlsx', '*.docx', '*.sql', '!/database/migrations/*.sql', '!/database/migrations/pgsql/*.sql', '!/database/control-plane/**/*.sql'] as $pattern) {
        if (!str_contains($gitignore, $pattern)) {
            $failures[] = "Missing .gitignore protection: {$pattern}";
        }
    }

    foreach (publication_forbidden_files(__DIR__) as $path) {
        $failures[] = "Forbidden publish-risk file outside private/runtime paths: {$path}";
    }

    foreach (publication_secret_findings(__DIR__) as $finding) {
        $failures[] = "Potential secret in {$finding['path']}:{$finding['line']} ({$finding['label']})";
    }

    if ($failures !== []) {
        foreach ($failures as $failure) {
            echo "FAIL: {$failure}\n";
        }
        throw new RuntimeException('Publication check failed.');
    }
    echo "OK: Required release files are present.\n";
    echo "OK: Private archive and runtime data patterns are ignored.\n";
    echo "OK: No forbidden publish-risk files found outside allowed paths.\n";
    echo "OK: No obvious secret or token patterns found in public files.\n";
}

function publication_forbidden_files(string $root): array
{
    $forbiddenExtensions = ['7z', 'rar', 'zip', 'tar', 'gz', 'tgz', 'xlsx', 'xls', 'docx', 'doc', 'pptx', 'ppt', 'pdf', 'sql'];
    $allowedSqlPrefixes = [
        $root . '/database/migrations/',
        $root . '/database/control-plane/',
    ];
    $failures = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveCallbackFilterIterator(
            new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS),
            function (SplFileInfo $file) use ($root): bool {
                if (!$file->isDir()) {
                    return true;
                }
                $relative = publication_relative_path($root, $file->getPathname());
                return !in_array($relative, [
                    '.git',
                    '.legacy-private',
                    '.playwright-cli',
                    'data/backups',
                    'data/config',
                    'data/exports',
                    'data/imports',
                    'data/privacy',
                    'dist',
                    'http',
                    'website/.playwright-cli',
                    'website/coverage',
                    'website/dist',
                    'website/node_modules',
                    'website/playwright-report',
                    'website/test-results',
                ], true);
            }
        )
    );
    foreach ($iterator as $file) {
        if (!$file instanceof SplFileInfo || !$file->isFile()) {
            continue;
        }
        $path = $file->getPathname();
        $relative = ltrim(str_replace($root, '', $path), '/');
        if (str_starts_with($relative, 'data/') && preg_match('/\.sqlite(?:-.+)?$/', $relative)) {
            continue;
        }
        $extension = strtolower(pathinfo($path, PATHINFO_EXTENSION));
        $allowedSql = false;
        if ($extension === 'sql') {
            foreach ($allowedSqlPrefixes as $prefix) {
                if (str_starts_with($path, $prefix)) {
                    $allowedSql = true;
                    break;
                }
            }
        }
        if ($allowedSql) {
            continue;
        }
        if (in_array($extension, $forbiddenExtensions, true)) {
            $failures[] = $relative;
        }
    }
    sort($failures);
    return $failures;
}

/**
 * @return array<int, array{path: string, line: int, label: string}>
 */
function publication_secret_findings(string $root): array
{
    $findings = [];
    foreach (publication_secret_scan_files($root) as $path) {
        $contents = file_get_contents($path);
        if ($contents === false || str_contains($contents, "\0")) {
            continue;
        }
        foreach (publication_secret_patterns() as $label => $pattern) {
            $matched = preg_match($pattern, $contents, $matches, PREG_OFFSET_CAPTURE);
            if ($matched !== 1) {
                continue;
            }
            $offset = (int) ($matches[0][1] ?? 0);
            $line = substr_count(substr($contents, 0, $offset), "\n") + 1;
            $findings[] = [
                'path' => publication_relative_path($root, $path),
                'line' => $line,
                'label' => $label,
            ];
        }
    }

    usort($findings, function (array $a, array $b): int {
        return [$a['path'], $a['line'], $a['label']] <=> [$b['path'], $b['line'], $b['label']];
    });
    return $findings;
}

/**
 * @return array<string, string>
 */
function publication_secret_patterns(): array
{
    return [
        'private key block' => '/-----BEGIN [A-Z ]*PRIVATE KEY-----/',
        'AWS access key' => '/\bAKIA[0-9A-Z]{16}\b/',
        'GitHub token' => '/\b(?:gh[opsru]_[A-Za-z0-9_]{30,}|github_pat_[A-Za-z0-9_]{20,})\b/',
        'OpenAI-style API key' => '/\bsk-(?:proj-)?[A-Za-z0-9_-]{20,}\b/',
        'Slack token' => '/\bxox[baprs]-[A-Za-z0-9-]{20,}\b/',
        'long bearer token' => '/Bearer\s+(?!\.\.\.|replace|example|token|test)[A-Za-z0-9._~+\/=-]{24,}/i',
    ];
}

/**
 * @return array<int, string>
 */
function publication_secret_scan_files(string $root): array
{
    $files = [];
    $skipDirs = [
        '.git',
        '.legacy-private',
        '.playwright-cli',
        'data',
        'dist',
        'http',
        'node_modules',
        'output',
        'vendor',
        'website/.playwright-cli',
        'website/coverage',
        'website/dist',
        'website/node_modules',
        'website/playwright-report',
        'website/test-results',
    ];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveCallbackFilterIterator(
            new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS),
            function (SplFileInfo $file) use ($root, $skipDirs): bool {
                if (!$file->isDir()) {
                    return true;
                }
                $relative = publication_relative_path($root, $file->getPathname());
                return !in_array($relative, $skipDirs, true);
            }
        )
    );

    foreach ($iterator as $file) {
        if (!$file instanceof SplFileInfo || !$file->isFile()) {
            continue;
        }
        $path = $file->getPathname();
        if (publication_text_file($path)) {
            $files[] = $path;
        }
    }
    sort($files);
    return $files;
}

function publication_text_file(string $path): bool
{
    $basename = basename($path);
    if (in_array($basename, ['placement', '.gitignore', '.htaccess'], true)) {
        return true;
    }
    $extension = strtolower(pathinfo($path, PATHINFO_EXTENSION));
    return in_array($extension, [
        'conf',
        'css',
        'csv',
        'example',
        'gitignore',
        'htaccess',
        'ini',
        'js',
        'json',
        'md',
        'php',
        'sql',
        'txt',
        'xml',
        'yaml',
        'yml',
    ], true);
}

function publication_relative_path(string $root, string $path): string
{
    return ltrim(str_replace(rtrim($root, '/') . '/', '', $path), '/');
}

