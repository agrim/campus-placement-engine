function bundle_import(array $args): void
{
    require_installed_app();
    $directory = '';
    if (isset($args[0]) && !str_starts_with((string) $args[0], '--')) {
        $directory = (string) array_shift($args);
    }
    $options = cli_options($args);
    $directory = (string) ($options['path'] ?? $directory);
    if ($directory === '' || in_array('--help', $args, true) || in_array('-h', $args, true)) {
        throw new RuntimeException('Usage: php placement bundle-import /path/to/bundle --confirm=IMPORT');
    }
    if (strtoupper((string) ($options['confirm'] ?? '')) !== 'IMPORT') {
        throw new RuntimeException('Portability import requires --confirm=IMPORT. It only accepts an empty operational database and writes a backup first.');
    }
    $result = (new PortalPortabilityService())->import($directory);
    echo "Portability bundle imported: {$result['bundle_id']}\n";
    echo "Pre-import backup: {$result['backup_path']}\n";
    foreach ($result['modules'] as $key => $counts) {
        echo "Module {$key}: " . json_encode($counts, JSON_UNESCAPED_SLASHES) . "\n";
    }
}

