function rollback_import(string $id): void
{
    if (!Database::isInstalled()) {
        throw new RuntimeException('App is not installed.');
    }
    if ($id === '' || in_array($id, ['--list', 'list'], true)) {
        $rows = (new ImportRollbackService())->recent(20);
        if ($rows === []) {
            echo "No import rollback snapshots found.\n";
            return;
        }
        echo "id,type,rows,created_at,status\n";
        $handle = fopen('php://output', 'w');
        foreach ($rows as $row) {
            $status = !empty($row['restored_at']) ? 'restored' : (!empty($row['backup_exists']) ? 'ready' : 'missing');
            Csv::writeRow($handle, [$row['id'], $row['type'], (int) $row['rows'], $row['created_at'], $status]);
        }
        fclose($handle);
        return;
    }
    $manifest = (new ImportRollbackService())->restore($id);
    echo "Restored import rollback snapshot: {$manifest['id']}\n";
    echo "Safety copy written: {$manifest['restore_safety_path']}\n";
}

